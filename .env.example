# Sample mode works without any credentials. Live calls are off by default.
ENABLE_LIVE_PROVIDERS=false
QLOO_API_KEY=
# Confirm the event credential's host instructions before enabling; never switch hosts silently.
QLOO_BASE_URL=https://hackathon.api.qloo.com
NEBIUS_API_KEY=
# Explicit Token Factory model ID with function calling; no default or provider fallback.
# Configure the project key and run paid inference only after explicit authorization.
NEBIUS_MODEL=

# Required for live production calls on Vercel. Leave blank for sample-only deployment.
# This origin check is not authentication; public live requests can incur provider charges.
LIVE_ALLOWED_ORIGIN=
